# Notion (subscriber list storage) — used by the app and the newsletter script
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Unsubscribe token signing — used by the app (/api/unsubscribe) and the
# newsletter script (to build unsubscribe links). Must be the SAME value
# in both places (Netlify env + GitHub Actions secret).
UNSUBSCRIBE_SECRET=

# Resend + site URL — only used by scripts/send-newsletter.ts, run via the
# "Daily Newsletter" GitHub Actions workflow. Not needed by the deployed app.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SITE_URL=https://syntaxpunk.com
